{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telecom-forge.local/schemas/patch-manifest.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "task_id", "task_sha", "publishable", "patches", "bundle_sha256"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string" },
    "task_id": { "type": "string" },
    "task_sha": { "type": "string" },
    "publishable": { "type": "boolean" },
    "outcome": { "enum": ["CHANGES", "NO_CHANGE", "DIAGNOSTIC"] },
    "patches": { "type": "array" },
    "bundle_sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
  }
}
