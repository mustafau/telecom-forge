{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telecom-forge.local/schemas/run-summary.schema.json",
  "type": "object",
  "required": ["schema_version", "task_id", "task_sha", "run_id", "status", "metrics"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string" },
    "task_sha": { "type": "string" },
    "run_id": { "type": "string" },
    "status": { "type": "string" },
    "failure_category": { "type": ["string", "null"] },
    "metrics": { "type": "object" }
  }
}
