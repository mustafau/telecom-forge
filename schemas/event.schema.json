{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telecom-forge.local/schemas/event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "timestamp", "task_id", "run_id", "attempt", "type", "phase", "severity", "data"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "minLength": 8 },
    "timestamp": { "type": "string" },
    "task_id": { "type": "string" },
    "run_id": { "type": "string" },
    "attempt": { "type": "integer", "minimum": 1 },
    "type": { "type": "string" },
    "phase": { "type": "string" },
    "repository": { "type": "string" },
    "severity": { "enum": ["info", "warning", "error"] },
    "data": { "type": "object" }
  }
}
