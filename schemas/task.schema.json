{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telecom-forge.local/schemas/task.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "task_branch", "feature_branch", "spec_file", "scope", "requirements", "acceptance", "constraints"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^TF-[0-9]{4,8}$" },
    "title": { "type": "string", "minLength": 8, "maxLength": 160 },
    "task_branch": { "type": "string", "minLength": 1, "pattern": "^task/" },
    "feature_branch": { "type": "string", "minLength": 1, "pattern": "^feature/" },
    "spec_file": { "const": "task.md" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writable_repositories"],
      "properties": {
        "writable_repositories": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "context_repositories": { "type": "array", "items": { "type": "string" } }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "implementation_required": { "type": "boolean" },
        "require_tests": { "type": "boolean" },
        "draft_pull_requests": { "const": true },
        "documentation_only": { "type": "boolean" }
      }
    },
    "acceptance": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } }
  }
}
