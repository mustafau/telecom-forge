{
  "name": "telecom-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Telecom-specific engineering metarepository for reviewed, AI-assisted changes across independent source repositories.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "bin": {
    "forge": "./dist/cli.js"
  },
  "scripts": {
    "forge": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1159.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@octokit/auth-app": "8.3.1",
    "@octokit/rest": "22.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "execa": "10.2.1",
    "luxon": "3.7.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.6",
    "eslint": "9.39.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.4"
  }
}
